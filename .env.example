# Azure PostgreSQL Flexible Server — UK South (London)
# Set these in Railway → your service → Variables
DB_HOST=your-server.postgres.database.azure.com
DB_USER=your_admin_user
DB_PASSWORD=your_password
DB_NAME=your_database_name
DB_PORT=5432
DB_SSL=true

# Or use a single connection string instead of the DB_* values above:
# DATABASE_URL=postgresql://user:password@your-server.postgres.database.azure.com:5432/your_database_name?sslmode=require

GEOCODE_API_KEY=YOUR_GEOCODE_MAPS_CO_KEY
PORT=3000
